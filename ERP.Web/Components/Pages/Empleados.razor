@page "/empleados"
@rendermode InteractiveServer
@inject IEmpleadoService EmpleadoService

<h3>Empleados
    <span @onclick="AgregarNuevo" class="btn btn-outline-success">+</span>
</h3>

@if(MostrarFormulario){
    <div class="card">
        <div class="card-header">@TituloOperacion</div>
        <div class="card-body">
            <div class="mt-1 form-group">
                <label class="form-label">Nombre Completo</label>
                <input class="form-control" type="text" @bind="Entrada.DatosPersonales.Nombre" />
            </div>
            <div class="row">
                <div class="col">
                    <div class="mt-1 form-group">
                        <label class="form-label">Fecha de Ingreso</label>
                        <input class="form-control" type="date" @bind="Entrada.DatosPersonales.FechaDeNacimiento" />
                    </div>
                </div>
                <div class="col">
                    <div class="mt-1 form-group">
                        <label class="form-label">Remuneración</label>
                        <input class="form-control" type="number" @bind="Entrada.Sueldo" />
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <span @onclick="GuardarCambios" class="btn btn-success">Guardar</span>
            <span @onclick="LimpiarFormulario" class="btn btn-danger">Cancelar</span>
        </div>
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Acciones</th>
                <th>#</th>
                <th>Nombre Completo</th>
                <th>Fecha de Ingreso</th>
                <th>Remuneración</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Registros)
            {
                <tr>
                    <th>
                        <div class="btn-group">
                            <span @onclick="()=>Actualizar(item.Id)" class="btn btn-warning">Editar</span>
                            <span @onclick="()=>Remover(item.Id)" class="btn btn-danger">Eliminar</span>
                        </div>
                    </th>
                    <th>@item.Id</th>
                    <th>@item.DatosPersonales.Nombre</th>
                    <th>@(item.DatosPersonales.FechaDeNacimiento?.ToString("dd/MM/yyyy") ?? "N/A")</th>
                    <th>@item.Sueldo.ToString("N2")</th>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    public string TituloOperacion { get; set; } = "";
    public EmpleadoDto Entrada { get; set; } = new();
    public List<EmpleadoDto> Registros { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        await CargarRegistros();
    }

    private async Task CargarRegistros()
    {
        Registros = await EmpleadoService.ObtenerRegistros("");
    }

    public bool MostrarFormulario { get; set; } = false;
    private void AlternarFormulario() => MostrarFormulario = !MostrarFormulario;
    private void LimpiarFormulario()
    {
        Entrada = new();
        AlternarFormulario();
    }

    private void AgregarNuevo()
    {
        LimpiarFormulario();
        TituloOperacion = "Nuevo Registro";
    }

    private async Task GuardarCambios()
    {
        var resultado = Entrada.Id == 0 ?
            await EmpleadoService.AgregarNuevo(Entrada) :
            await EmpleadoService.Actualizar(Entrada);
        if (resultado)
        {
            await CargarRegistros();
            LimpiarFormulario();
        }
    }

    private void Actualizar(int Id)
    {
        LimpiarFormulario();
        TituloOperacion = "Actualizar Registro";
        Entrada = Registros
            .Where(e => e.Id == Id)
            .FirstOrDefault() ?? new();
    }

    private async Task Remover(int Id)
    {
        var resultado = await EmpleadoService.Remover(Id);
        if (resultado)
        {
            await CargarRegistros();
        }
    }
} 